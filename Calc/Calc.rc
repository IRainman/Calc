//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\C.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 118, 71
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_BORDER | WS_SYSMENU
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,83,14,20,20
    LTEXT           "Calc, version 2.0.0 2023",IDC_STATIC,7,7,83,8,SS_NOPREFIX
    LTEXT           "© STUDIO2000, HedgehogInTheCPP",IDC_STATIC,7,24,71,26
    DEFPUSHBUTTON   "OK",IDOK,75,50,36,14,WS_GROUP
    DEFPUSHBUTTON   "Homepage",ID_SITE,7,50,56,14,WS_GROUP
    LTEXT           "",IDC_COMPILED_DATE,7,16,77,8,SS_NOPREFIX
END

IDD_CALC_DIALOG DIALOGEX 0, 0, 217, 187
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Calc"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_EDIT_INPUT,7,7,203,30,ES_MULTILINE | ES_AUTOVSCROLL
    EDITTEXT        IDC_EDIT_RESULT,7,59,203,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_MESSAGE,7,75,203,105,ES_MULTILINE | ES_READONLY | WS_VSCROLL
    CONTROL         "Calculate immediately. If unchecked, there should be a = sign at the end of the expression",IDC_CHECK_AUTO_CALCULATE,
                    "Button",BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP,7,38,203,17
END


