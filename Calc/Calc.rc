//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 146, 59
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "О проекте Calc"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,105,12,21,20
    LTEXT           "Calc, версия 1.0",IDC_STATIC,15,15,68,8,SS_NOPREFIX
    LTEXT           "(C) МИЭТ, Соломин А.Л. группа МПВ-51 2009",IDC_STATIC,15,25,82,19
    DEFPUSHBUTTON   "ОК",IDOK,89,38,50,14,WS_GROUP
END

IDD_CALC_DIALOG DIALOGEX 0, 0, 217, 153
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Calc"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
